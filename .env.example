# Google OAuth 2.0 / OpenID Connect credentials. Never commit real values.
GOOGLE_AUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Use a long, random secret (at least 32 characters) to encrypt the HttpOnly session cookie.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Exactly two comma-separated Google account emails. Comparison is trimmed and case-insensitive.
ALLOWED_USER_EMAILS=first.user@example.com,second.user@example.com

# Local development: http://localhost:3000
# Production: https://your-project.vercel.app
APP_URL=http://localhost:3000

# Google Drive setup configuration. The designated owner must be one of ALLOWED_USER_EMAILS.
GOOGLE_DRIVE_OWNER_EMAIL=first.user@example.com

# Browser-visible Picker configuration. Restrict this API key to your app origins and Google Picker/Drive APIs.
GOOGLE_PICKER_API_KEY=your-restricted-google-picker-api-key
GOOGLE_PROJECT_NUMBER=your-google-cloud-project-number

# Set these manually only after the owner completes the one-time Drive setup flow.
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-existing-warranty-vault-folder-id

# Secret: never commit, log, or expose this runtime token to the browser.
GOOGLE_DRIVE_REFRESH_TOKEN=your-google-drive-refresh-token
