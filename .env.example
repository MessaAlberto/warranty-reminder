# Google OAuth 2.0 / OpenID Connect credentials. Never commit real values.
GOOGLE_AUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Use a long, random secret (at least 32 characters) to encrypt the HttpOnly session cookie.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Exactly two comma-separated Google account emails. Comparison is trimmed and case-insensitive.
ALLOWED_USER_EMAILS=first.user@example.com,second.user@example.com

# Local development: http://localhost:3000
# Production: https://your-project.vercel.app
APP_URL=http://localhost:3000
